{
  "name": "wowgearmatrix",
  "version": "1.0.0",
  "private": true,
  "description": "WoWGearMatrix - 魔兽世界配装工具",
  "license": "GPL-3.0-or-later",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit/*.cjs",
    "dist:win": "node scripts/package-win-portable.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "test:engine": "node --test tests/engine/*.cjs",
    "test:electron": "node scripts/run-electron-tests.cjs",
    "test:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "release:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "productName": "WoW配装",
  "build": {
    "appId": "local.wowgearmatrix",
    "productName": "WoW配装",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "src/**/*",
      "data/item-names.json",
      "data/item-names.source.json",
      "assets/empty-prismatic-socket.png",
      "engine/gear-resolver.js",
      "engine/gear-resolver.wasm",
      "engine/LICENSE",
      "engine/COPYING",
      "engine/manifest.json",
      "node_modules/sortablejs/Sortable.min.js",
      "node_modules/sortablejs/LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "WoWGearMatrix-${version}-${env.WOWGEARMATRIX_BUILD_TIMESTAMP}-win-x64-portable.exe"
    },
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "executableName": "WoWGearMatrix"
  },
  "dependencies": {
    "sortablejs": "1.15.7"
  }
}
